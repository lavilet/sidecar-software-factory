#!/usr/bin/env ruby

require "optparse"
require "json"

HARNESS_LIB = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(HARNESS_LIB)

require "harness/errors"
require "harness/config_file"
require "harness/logger"
require "harness/backends/base"
require "harness/backends/codex"
require "harness/backends/antigravity"
require "harness/backends/gemini"
require "harness/scout"

repo_root = Dir.pwd
cfg = Harness::ConfigFile.load(repo_root)

options = {
  backend_spec: cfg.role("scout"),
  create_issues: false,
  max_issues: 2,
  dry_run: false
}

parser = OptionParser.new do |o|
  o.banner = "Usage: factory scout [options]"
  o.on("--backend SPEC", "Backend[:model] for Scout (default: from profile config.toml)") { |v| options[:backend_spec] = v }
  o.on("--create-issues", "Open deduplicated GitHub proposal issues labeled agent:needs-info") { options[:create_issues] = true }
  o.on("--max-issues N", Integer, "Max GitHub proposal issues per run (default: 2)") { |v| options[:max_issues] = v }
  o.on("--dry-run", "Write scout prompt without calling LLM or GitHub") { options[:dry_run] = true }
  o.on("-h", "--help", "Show help") do
    puts o
    exit 0
  end
end

parser.parse!

logger = Harness::Logger.new(File.join(Harness::Paths.profile(repo_root), "runs", "scout.log"))
parsed = Harness::Backends.parse_spec(options[:backend_spec])
backend = Harness::Backends.build(parsed.backend, logger: logger, repo_root: repo_root)

result = Harness::Scout.new(
  repo_root: repo_root,
  backend: backend,
  model: parsed.model,
  reasoning_effort: cfg.effort("scout"),
  logger: logger
).call(
  create_issues: options[:create_issues],
  max_issues: options[:max_issues],
  dry_run: options[:dry_run]
)

puts JSON.pretty_generate(result[:report] || result)
