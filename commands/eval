#!/usr/bin/env ruby

require "optparse"

HARNESS_LIB = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(HARNESS_LIB)

require "harness/errors"
require "harness/config_file"
require "harness/cost_estimator"
require "harness/session_store"
require "harness/logger"
require "harness/telemetry"
require "harness/workspace"
require "harness/prompts"
require "harness/handoff"
require "harness/backends/base"
require "harness/backends/codex"
require "harness/backends/antigravity"
require "harness/backends/gemini"
require "harness/arbitrage_reviewer"
require "harness/verifier"
require "harness/qa"
require "harness/runner"
require "harness/eval_runner"

repo_root = Dir.pwd
cfg = Harness::ConfigFile.load(repo_root)
options = {
  filter: nil,
  architect_spec: cfg.role("architect"),
  worker_spec: cfg.role("worker"),
  reviewer_specs: cfg.reviewer_specs,
  qa_spec: cfg.role("qa"),
  update_baseline: false
}

parser = OptionParser.new do |o|
  o.banner = "Usage: factory eval [options]"
  o.on("--filter TEXT", "Run only eval tasks whose filename includes TEXT") { |v| options[:filter] = v }
  o.on("--architect SPEC", "Backend[:model] for Architect") { |v| options[:architect_spec] = v }
  o.on("--worker SPEC", "Backend[:model] for Worker") { |v| options[:worker_spec] = v }
  o.on("--reviewers LIST", "Comma-separated reviewer specs") { |v| options[:reviewer_specs] = v.split(",").map(&:strip) }
  o.on("--update-baseline", "Write results to profile evals/baseline.json") { options[:update_baseline] = true }
  o.on("-h", "--help", "Show help") do
    puts o
    exit 0
  end
end

parser.parse!

logger = Harness::Logger.new(File.join(Harness::Paths.profile(repo_root), "runs", "eval.log"))

runner_factory = lambda do |task_id:, playbook:, brief:, done_if:, base_branch:|
  config = Harness::Config.new(
    task_id: task_id,
    playbook: playbook,
    brief: brief,
    done_if: done_if,
    base_branch: base_branch,
    backend: options[:worker_spec],
    model: nil,
    architect_spec: options[:architect_spec],
    worker_spec: options[:worker_spec],
    reviewer_specs: options[:reviewer_specs],
    qa_spec: options[:qa_spec],
    max_verify_loops: 3,
    max_review_loops: 2,
    skip_architect: false,
    skip_review: false,
    run_qa: false,
    qa_scenario: nil,
    upload_evidence: false,
    open_pr: false,
    push_only: false,
    dry_run: false
  )
  Harness::Runner.new(config, repo_root: repo_root).run
end

summary = Harness::EvalRunner.new(
  repo_root: repo_root,
  logger: logger,
  runner_factory: runner_factory
).call(task_filter: options[:filter], update_baseline: options[:update_baseline])

puts JSON.pretty_generate(summary)

exit 1 if summary[:passed] < summary[:total]
