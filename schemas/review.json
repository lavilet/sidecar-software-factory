{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarnessReviewResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approved",
    "summary",
    "done_if_met",
    "architecture_violations",
    "blocking_issues",
    "non_blocking_notes"
  ],
  "properties": {
    "approved": {
      "type": "boolean",
      "description": "Must be true only when done_if_met is true and both architecture_violations and blocking_issues are empty."
    },
    "summary": {
      "type": "string",
      "description": "Concise 1-3 sentence review verdict."
    },
    "done_if_met": {
      "type": "boolean",
      "description": "Whether every requirement in done_if is backed by the diff and verification evidence."
    },
    "architecture_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "rule", "explanation"],
        "properties": {
          "file": { "type": "string" },
          "rule": { "type": "string" },
          "explanation": { "type": "string" }
        }
      }
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "issue", "fix_hint"],
        "properties": {
          "file": { "type": "string" },
          "issue": { "type": "string" },
          "fix_hint": { "type": "string" }
        }
      }
    },
    "non_blocking_notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
