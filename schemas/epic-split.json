{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarnessEpicSplitPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["epic_number", "summary", "tasks"],
  "properties": {
    "epic_number": { "type": "integer" },
    "summary": { "type": "string" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "pilot", "depends_on_keys", "playbook", "body", "done_if"],
        "properties": {
          "key": { "type": "string" },
          "title": { "type": "string" },
          "pilot": { "type": "boolean" },
          "depends_on_keys": {
            "type": "array",
            "items": { "type": "string" }
          },
          "playbook": {
            "type": "string",
            "enum": ["bugfix", "feature"]
          },
          "body": { "type": "string" },
          "done_if": { "type": "string" }
        }
      }
    }
  }
}
